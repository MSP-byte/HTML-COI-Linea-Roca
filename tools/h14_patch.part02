tchEvent(new CustomEvent('coi:h14-profile',{detail:{profile:window.__COI_H14_PROFILE__,user}}));
}
async function validarYDesbloquear(user){
  if(applying)return false;
  applying=true;
  try{
    setMessage('Validando perfil y permisos…','loading');
    const p=await cargarPerfil(user);
    aplicarPerfil(p,user);
    const client=getClient();
    if(client){client.from('profiles').update({ultimo_login:new Date().toISOString()}).eq('id',user.id).then(()=>{}).catch(()=>{});}
    unlockGate();
    return true;
  }catch(error){
    console.error('[COI][H14] perfil rechazado',error);
    profile=null;window.__COI_H14_PROFILE__=null;window.__COI_H14_AUTH_READY__=false;
    try{const client=getClient();if(client)await client.auth.signOut();}catch(signOutError){}
    lockGate(error?.message||'No se pudo validar el acceso.');
    return false;
  }finally{applying=false;}
}
async function restaurarSesion(){
  if(isE2EBypass()){
    window.__COI_H14_E2E_BYPASS__=true;document.documentElement.classList.remove('coi-h14-locked');$('coiAuthGateH14')?.setAttribute('hidden','');return;
  }
  lockGate();setMessage('Verificando sesión…','loading');
  try{
    const client=await ensureClient();
    const {data,error}=await client.auth.getSession();
    if(error)throw error;
    const user=data?.session?.user||null;
    if(user){await validarYDesbloquear(user);return;}
    setMessage('Ingresá con un usuario habilitado para continuar.','');
  }catch(error){
    lockGate(error?.message||'No se pudo verificar la sesión.');
  }
}
async function submitLogin(event){
  event.preventDefault();
  const email=clean($('coiAuthEmailH14')?.value),password=String($('coiAuthPasswordH14')?.value||'');
  if(!email||!password){setMessage('Completá correo y contraseña.','error');return;}
  const button=$('coiAuthSubmitH14');if(button)button.disabled=true;
  setMessage('Validando credenciales…','loading');
  try{
    await ensureClient();
    let user=null;
    if(typeof window.loginSupabase==='function')user=await window.loginSupabase(email,password);
    else{
      const {data,error}=await getClient().auth.signInWithPassword({email,password});if(error)throw error;user=data?.user||data?.session?.user||null;
    }
    if(!user)throw new Error('Supabase no devolvió un usuario válido.');
    const ok=await validarYDesbloquear(user);
    if(ok){if($('coiAuthPasswordH14'))$('coiAuthPasswordH14').value='';setMessage('Acceso autorizado.','ok');}
  }catch(error){
    console.warn('[COI][H14] login',error);
    setMessage(error?.message||'No se pudo iniciar sesión.','error');
    if($('coiAuthPasswordH14'))$('coiAuthPasswordH14').value='';
  }finally{if(button)button.disabled=false;}
}
function installAuthListener(){
  if(authListenerInstalled)return;authListenerInstalled=true;
  window.addEventListener('coi:supabase-auth',event=>{
    const authEvent=event.detail?.event,session=event.detail?.session;
    if(authEvent==='SIGNED_OUT'){profile=null;window.__COI_H14_PROFILE__=null;window.__COI_H14_AUTH_READY__=false;lockGate('Sesión cerrada. Ingresá nuevamente para continuar.');return;}
    if(['SIGNED_IN','INITIAL_SESSION','USER_UPDATED','TOKEN_REFRESHED'].includes(authEvent)&&session?.user){Promise.resolve().then(()=>validarYDesbloquear(session.user));}
  });
}
function installUI(){
  $('coiAuthFormH14')?.addEventListener('submit',submitLogin);
  $('coiAuthPasswordToggleH14')?.addEventListener('click',()=>{
    const input=$('coiAuthPasswordH14'),btn=$('coiAuthPasswordToggleH14');if(!input||!btn)return;
    const show=input.type==='password';input.type=show?'text':'password';btn.textContent=show?'Ocultar':'Mostrar';btn.setAttribute('aria-pressed',show?'true':'false');
  });
}
async function init(){
  if(bootDone)return;bootDone=true;installUI();installAuthListener();await restaurarSesion();
}
window.COI_H14={version:H14,getProfile:()=>window.__COI_H14_PROFILE__||null,normalizarRol,lock:lockGate,restore:restaurarSesion};
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
})();
</script>'''

# Head: estilos + pre-lock before body is parsed.
if '</head>' not in TEXT.lower():
    raise SystemExit('No se encontró </head>.')
TEXT = re.sub(r'</head>', STYLE + '\n</head>', TEXT, count=1, flags=re.I)

# Gate as the first element of body so there is no unprotected app flash.
match = re.search(r'<body\b[^>]*>', TEXT, flags=re.I)
if not match:
    raise SystemExit('No se encontró <body>.')
TEXT = TEXT[:match.end()] + '\n' + MARKUP + '\n' + TEXT[match.end():]

# Runtime controller at the end, after the existing Supabase/Auth functions.
close_body = list(re.finditer(r'</body>', TEXT, flags=re.I))
if not close_body:
    raise SystemExit('No se encontró </body>.')
pos = close_body[-1].start()
TEXT = TEXT[:pos] + '\n' + SCRIPT + '\n' + TEXT[pos:]

# H14: UI operational editors are Administrador + COI. Admin-only operations remain
# guarded by esAutorizacionAdministrativaSupabaseV60/profile checks and RLS.
old_edit = """function usuarioTienePermisoEdicion(){\n  return window.APP_STATE?.role==='administrador'&&typeof window.esAutorizacionAdministrativaSupabaseV60==='function'&&window.esAutorizacionAdministrativaSupabaseV60();\n}"""
new_edit = """function usuarioTienePermisoEdicion(){\n  const role=String(window.APP_STATE?.role||'').toLowerCase();\n  if(role==='administrador')return typeof window.esAutorizacionAdministrativaSupabaseV60==='function'&&window.esAutorizacionAdministrativaSupabaseV60();\n  if(role==='coi')return Boolean(window.APP_STATE?.user&&window.__COI_H14_PROFILE__?.activo!==false);\n  return false;\n}\nwindow.usuarioTienePermisoEdicion=usuarioTienePermisoEdicion;"""
if old_edit in TEXT:
    TEXT = TEXT.replace(old_edit, new_edit)
else:
    raise SystemExit('No se encontró el guard de edición R12 esperado.')

INDEX.write_text(TEXT, encoding='utf-8', newline='\n')

# Static contract for H14.
test_path = ROOT / 'tests' / 'check_h14_auth_gate.js'
test_path.write_text(r'''const fs = require('fs');
const assert = require('assert');
const html = fs.readFileSync('index.html','utf8');
assert(html.includes('id="coiAuthGateH14"'), 'Debe existir el gate institucional H14');
assert(html.includes('id="coi-auth-h14-prelock"'), 'Debe existir pre-lock contra flash no autenticado');
assert(html.includes('data:image/jpeg;base64,'), 'La imagen de Plaza Constitución debe quedar embebida en index.html');
assert(html.includes("from('profiles').select('id,email,nombre,apellido,rol,activo')")